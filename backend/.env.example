# ─── Server ───────────────────────────────────────────────
# development enables POST /api/auth/dev-login (login without Firebase): never use it in production.
# If NODE_ENV is unset the server runs as production.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*

# ─── Database ─────────────────────────────────────────────
# `npm run db:start` starts a local Postgres matching this URL, no Docker needed.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/community_app

# ─── JWT ──────────────────────────────────────────────────
# Must be at least 32 characters
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Firebase (auth: email + password, push notifications) ───
# Paste the contents of your serviceAccountKey.json as a single-line JSON string.
# Required in production. In development the server also starts without a valid
# key: Firebase login answers 503 and push notifications are skipped.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ─── Business rules ───────────────────────────────────────
CONFIRMATION_INTERVAL_DAYS=30
CONFIRMATION_GRACE_DAYS=3

# Admin contact
ADMIN_CONTACT_EMAIL=admin@example.com

# Sharing channel (minutes before scheduled close to warn participants)
SHARING_CHANNEL_WARN_MINUTES=15
