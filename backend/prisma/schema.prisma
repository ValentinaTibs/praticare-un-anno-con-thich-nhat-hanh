generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  super_admin
  admin
  user
}

enum UserStatus {
  active
  suspended
  banned
}

enum SharingChannelStatus {
  open
  closed
}

enum ConfirmationStatus {
  pending
  confirmed
  missed
}

enum CycleStatus {
  open
  closed
}

model User {
  id              String     @id @default(uuid())
  name            String
  surname         String
  email           String     @unique @map("email")
  motivation      String
  role            Role       @default(user)
  status          UserStatus @default(active)
  reviewedByAdmin Boolean    @default(false) @map("reviewed_by_admin")
  lastConfirmedAt DateTime?  @map("last_confirmed_at")
  groupId         String?    @map("group_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  group                 Group?                 @relation(fields: [groupId], references: [id], onDelete: SetNull)
  devices               UserDevice[]
  refreshTokens         RefreshToken[]
  mainChannelPosts      MainChannelPost[]
  sharingChannelSession SharingChannelMember[]
  sharingChannelPosts   SharingChannelPost[]
  confirmationRequests  ConfirmationRequest[]
  openedSharingChannels SharingChannel[]
  openedCycles          RegistrationCycle[]
  participationRequests ParticipationRequest[]

  @@map("users")
}

model UserDevice {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  fcmToken  String   @unique @map("fcm_token")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_devices")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model MainChannelPost {
  id          String    @id @default(uuid())
  authorId    String?   @map("author_id")
  content     String
  mediaUrl    String?   @map("media_url")
  scheduledAt DateTime? @map("scheduled_at")
  publishedAt DateTime? @map("published_at")
  isDraft     Boolean   @default(false) @map("is_draft")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@map("main_channel_posts")
}

model SharingChannel {
  id                String               @id @default(uuid())
  groupId           String               @map("group_id")
  status            SharingChannelStatus @default(closed)
  openedBy          String?              @map("opened_by")
  openedAt          DateTime?            @map("opened_at")
  scheduledClosedAt DateTime?            @map("scheduled_closed_at")
  closedAt          DateTime?            @map("closed_at")
  closingWarningAt  DateTime?            @map("closing_warning_at")

  group   Group                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  opener  User?                  @relation(fields: [openedBy], references: [id])
  members SharingChannelMember[]
  posts   SharingChannelPost[]

  @@unique([groupId, openedAt])
  @@map("sharing_channel")
}

// The single weekly appointment shared by every group's sharing channel, in
// Italian time. Only appointments starting after updatedAt count, so a change
// never opens a channel late.
model SharingChannelSchedule {
  id              Int      @id @default(1)
  dayOfWeek       Int      @map("day_of_week") // ISO: 1 = Monday … 7 = Sunday
  startTime       String   @map("start_time") // HH:MM
  durationMinutes Int      @map("duration_minutes")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("sharing_channel_schedule")
}

model SharingChannelMember {
  id               String   @id @default(uuid())
  sharingChannelId String   @map("sharing_channel_id")
  userId           String   @map("user_id")
  joinedAt         DateTime @default(now()) @map("joined_at")

  sharingChannel SharingChannel @relation(fields: [sharingChannelId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sharingChannelId, userId])
  @@map("sharing_channel_members")
}

model SharingChannelPost {
  id               String   @id @default(uuid())
  sharingChannelId String   @map("sharing_channel_id")
  authorId         String   @map("author_id")
  content          String
  mediaUrl         String?  @map("media_url")
  createdAt        DateTime @default(now()) @map("created_at")

  sharingChannel SharingChannel @relation(fields: [sharingChannelId], references: [id], onDelete: Cascade)
  author         User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("sharing_channel_posts")
}

model ConfirmationRequest {
  id          String             @id @default(uuid())
  userId      String             @map("user_id")
  dueAt       DateTime           @map("due_at")
  confirmedAt DateTime?          @map("confirmed_at")
  status      ConfirmationStatus @default(pending)
  createdAt   DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("confirmation_requests")
}

model RegistrationCycle {
  id                String      @id @default(uuid())
  status            CycleStatus @default(closed)
  openedBy          String?     @map("opened_by")
  openedAt          DateTime?   @map("opened_at")
  scheduledClosedAt DateTime?   @map("scheduled_closed_at")
  closedAt          DateTime?   @map("closed_at")
  startsAt          DateTime    @map("starts_at")
  durationDays      Int         @default(365) @map("duration_days")

  opener                User?                  @relation(fields: [openedBy], references: [id])
  group                 Group?
  participationRequests ParticipationRequest[]
  removedRequesters     RemovedRequester[]

  @@map("registration_cycles")
}

model ParticipationRequest {
  id        String   @id @default(uuid())
  cycleId   String   @map("cycle_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  cycle RegistrationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cycleId, userId])
  @@index([userId])
  @@map("participation_requests")
}

// Who was removed by an admin with a request in progress. Keyed by email, not by
// user: they may register again, as a new user, but not ask again in this cycle.
model RemovedRequester {
  cycleId String @map("cycle_id")
  email   String

  cycle RegistrationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@id([cycleId, email])
  @@map("removed_requesters")
}

// The users registered in the same registration cycle. Each group has its own
// Main Channel, sharing channel and confirmation rounds.
model Group {
  id        String    @id @default(uuid())
  cycleId   String    @unique @map("cycle_id")
  startedAt DateTime  @map("started_at")
  endedAt   DateTime? @map("ended_at")
  createdAt DateTime  @default(now()) @map("created_at")

  cycle           RegistrationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  members         User[]
  sharingChannels SharingChannel[]

  @@map("groups")
}

model BannedEmail {
  id        String   @id @default(uuid())
  email     String   @unique @map("email")
  bannedAt  DateTime @default(now()) @map("banned_at")

  @@map("banned_emails")
}
