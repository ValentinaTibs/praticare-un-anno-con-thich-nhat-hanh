generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  super_admin
  admin
  user
}

enum UserStatus {
  active
  suspended
  banned
}

enum SharingChannelStatus {
  open
  closed
}

enum ConfirmationStatus {
  pending
  confirmed
  missed
}

enum TemplateStatus {
  draft
  scheduled
}

enum CycleStatus {
  open
  closed
}

model User {
  id              String     @id @default(uuid())
  name            String
  surname         String
  email           String     @unique @map("email")
  motivation      String
  role            Role       @default(user)
  status          UserStatus @default(active)
  reviewedByAdmin Boolean    @default(false) @map("reviewed_by_admin")
  lastConfirmedAt DateTime?  @map("last_confirmed_at")
  // When the user accepted the privacy policy at registration. Accounts created otherwise,
  // like the Super Admin's, have none.
  privacyAcceptedAt DateTime? @map("privacy_accepted_at")
  groupId         String?    @map("group_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  group                 Group?                 @relation(fields: [groupId], references: [id], onDelete: SetNull)
  devices               UserDevice[]
  refreshTokens         RefreshToken[]
  mainChannelTemplates  MainChannelTemplate[]
  mainChannelPosts      MainChannelPost[]
  sharingChannelSession SharingChannelMember[]
  sharingChannelPosts   SharingChannelPost[]
  confirmationRequests  ConfirmationRequest[]
  openedSharingChannels SharingChannel[]
  openedCycles          RegistrationCycle[]
  participationRequests ParticipationRequest[]

  @@map("users")
}

model UserDevice {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  fcmToken  String   @unique @map("fcm_token")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_devices")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// The single sequence of Main Channel posts shared by every group: each template is
// copied into a group's Main Channel when the group reaches its journey day and time.
model MainChannelTemplate {
  id          String         @id @default(uuid())
  authorId    String?        @map("author_id")
  content     String
  journeyDay  Int            @map("journey_day") // 1 = the group's start date
  publishTime String         @default("08:00") @map("publish_time") // HH:MM, Italian time
  status      TemplateStatus @default(draft)
  // When the template last entered the sequence at its current day and time: a group
  // that had already reached that moment doesn't receive it.
  sequencedAt DateTime?      @map("sequenced_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  author       User?                    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  posts        MainChannelPost[]
  publications MainChannelPublication[]

  @@index([status, journeyDay])
  @@map("main_channel_templates")
}

// That a template has been published in a group. It outlives the copy, so a copy
// deleted by an admin is never published again.
model MainChannelPublication {
  groupId     String   @map("group_id")
  templateId  String   @map("template_id")
  publishedAt DateTime @map("published_at")

  group    Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  template MainChannelTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([groupId, templateId])
  @@index([templateId])
  @@map("main_channel_publications")
}

// A post published in a group's Main Channel. It is born at publication, as a copy
// of a template or without one, and then lives on its own. The announcement of a
// sharing channel is a post without template, linked to the channel it opens.
model MainChannelPost {
  id               String   @id @default(uuid())
  groupId          String   @map("group_id")
  templateId       String?  @map("template_id")
  sharingChannelId String?  @unique @map("sharing_channel_id")
  authorId         String?  @map("author_id")
  content          String
  publishedAt      DateTime @map("published_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  group          Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  template       MainChannelTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sharingChannel SharingChannel?      @relation(fields: [sharingChannelId], references: [id], onDelete: SetNull)
  author         User?                @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([groupId, publishedAt])
  @@index([templateId])
  @@map("main_channel_posts")
}

model SharingChannel {
  id                String               @id @default(uuid())
  groupId           String               @map("group_id")
  status            SharingChannelStatus @default(closed)
  openedBy          String?              @map("opened_by")
  openedAt          DateTime?            @map("opened_at")
  scheduledClosedAt DateTime?            @map("scheduled_closed_at")
  closedAt          DateTime?            @map("closed_at")
  closingWarningAt  DateTime?            @map("closing_warning_at")

  group   Group                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  opener  User?                  @relation(fields: [openedBy], references: [id])
  members      SharingChannelMember[]
  posts        SharingChannelPost[]
  announcement MainChannelPost?

  @@unique([groupId, openedAt])
  @@map("sharing_channel")
}

// The single weekly appointment shared by every group's sharing channel, in
// Italian time. Only appointments starting after updatedAt count, so a change
// never opens a channel late.
model SharingChannelSchedule {
  id              Int      @id @default(1)
  dayOfWeek       Int      @map("day_of_week") // ISO: 1 = Monday … 7 = Sunday
  startTime       String   @map("start_time") // HH:MM
  durationHours   Int      @map("duration_hours")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("sharing_channel_schedule")
}

// Whoever entered the channel. Leaving keeps the row, so the channel knows how many
// people took part and who comes back: back in, they see only the messages from then.
model SharingChannelMember {
  id               String    @id @default(uuid())
  sharingChannelId String    @map("sharing_channel_id")
  userId           String    @map("user_id")
  joinedAt         DateTime  @default(now()) @map("joined_at")
  leftAt           DateTime? @map("left_at")
  rejoinedAt       DateTime? @map("rejoined_at")

  sharingChannel SharingChannel @relation(fields: [sharingChannelId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sharingChannelId, userId])
  @@map("sharing_channel_members")
}

model SharingChannelPost {
  id               String   @id @default(uuid())
  sharingChannelId String   @map("sharing_channel_id")
  authorId         String   @map("author_id")
  content          String
  createdAt        DateTime @default(now()) @map("created_at")

  sharingChannel SharingChannel @relation(fields: [sharingChannelId], references: [id], onDelete: Cascade)
  author         User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("sharing_channel_posts")
}

model ConfirmationRequest {
  id          String             @id @default(uuid())
  userId      String             @map("user_id")
  dueAt       DateTime           @map("due_at")
  confirmedAt DateTime?          @map("confirmed_at")
  status      ConfirmationStatus @default(pending)
  createdAt   DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("confirmation_requests")
}

model RegistrationCycle {
  id                String      @id @default(uuid())
  status            CycleStatus @default(closed)
  openedBy          String?     @map("opened_by")
  openedAt          DateTime?   @map("opened_at")
  scheduledClosedAt DateTime?   @map("scheduled_closed_at")
  closedAt          DateTime?   @map("closed_at")
  startsAt          DateTime    @map("starts_at")
  durationDays      Int         @default(365) @map("duration_days")

  opener                User?                  @relation(fields: [openedBy], references: [id])
  group                 Group?
  participationRequests ParticipationRequest[]
  removedRequesters     RemovedRequester[]

  @@map("registration_cycles")
}

model ParticipationRequest {
  id        String   @id @default(uuid())
  cycleId   String   @map("cycle_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  cycle RegistrationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cycleId, userId])
  @@index([userId])
  @@map("participation_requests")
}

// Who was removed by an admin with a request in progress. Keyed by email, not by
// user: they may register again, as a new user, but not ask again in this cycle.
model RemovedRequester {
  cycleId String @map("cycle_id")
  email   String

  cycle RegistrationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@id([cycleId, email])
  @@map("removed_requesters")
}

// The users registered in the same registration cycle. Each group has its own
// Main Channel, sharing channel and confirmation rounds.
model Group {
  id        String    @id @default(uuid())
  cycleId   String    @unique @map("cycle_id")
  startedAt DateTime  @map("started_at")
  endedAt   DateTime? @map("ended_at")
  createdAt DateTime  @default(now()) @map("created_at")

  cycle           RegistrationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  members          User[]
  sharingChannels  SharingChannel[]
  mainChannelPosts MainChannelPost[]
  publications     MainChannelPublication[]

  @@map("groups")
}

model BannedEmail {
  id        String   @id @default(uuid())
  email     String   @unique @map("email")
  bannedAt  DateTime @default(now()) @map("banned_at")

  @@map("banned_emails")
}
